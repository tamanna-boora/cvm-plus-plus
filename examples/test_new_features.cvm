// test each new feature one by one

print("testing !=");
print(1 != 2);
print(1 != 1);

print("testing >=");
print(5 >= 3);
print(3 >= 5);

print("testing <=");
print(3 <= 5);
print(5 <= 3);

print("testing %");
print(10 % 3);
print(15 % 5);

print("testing strings");
print("hello from CVM++");

print("all features working");
